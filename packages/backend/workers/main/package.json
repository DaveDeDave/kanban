{
  "name": "@kanban/main-worker",
  "version": "1.0.0",
  "repository": "https://github.com/DaveDeDave/kanban",
  "author": "Davide Ceci",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "deploy": "wrangler deploy src/index.ts --minify --compatibility-date 2024-09-23 --compatibility-flags nodejs_compat --name main",
    "dev": "wrangler dev --config local.toml --env development",
    "tail": "wrangler tail --name main",
    "build": "tsc -b",
    "build:clean": "tsc -b --clean",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "check:lint": "eslint . --config ../../../../.eslintrc.json",
    "check:prettier": "yarn run -T prettier --check \"{src,test,scripts}/**/*.{ts,tsx}\" \"*.ts\" --config ../../../../.prettierrc",
    "check:prettier:fix": "yarn run -T prettier --write \"{src,test,scripts}/**/*.{ts,tsx}\" \"*.ts\" --config ../../../../.prettierrc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:clear": "tsx scripts/db.ts clear",
    "test:integration": "yarn node --experimental-vm-modules $(yarn bin jest) test/integration --runInBand"
  },
  "dependencies": {
    "@kanban/base-lib": "1.0.0",
    "@trpc/server": "^10.45.2",
    "drizzle-orm": "^0.45.3",
    "lexorank": "^1.0.5",
    "pg": "^8.23.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240222.0",
    "@types/jest": "^29.5.12",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.2",
    "wrangler": "^4"
  }
}
